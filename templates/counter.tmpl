{{ define "counter.tmpl"}}
{{ template "header.tmpl" . }}

    <template id="reset-card-template">
      <li class="p-2">
        <div class="list-group-item p-2">
          <div class="container">
            <div class="row border-bottom mb-2 pb-2">
              <div class="col d-flex flex-column justify-content-center">
                <div class="text-center my-auto">
                  <span class="fs-5 reset-desc"></span>
                  <br/>
                  <span class="description"><i>reported by: <span class="reset-user"></span></i></span>
                  <br/>
                  <span class="description"><i><span class="reset-timestamp"></span></i></span>
                </div>
              </div>
              <div class="col">
                <div class="text-center my-auto">
                  <span class="days-since fw-bold display-3"></span>
                  <span class="description d-block">Day(s) Ago</span>
                </div>
              </div>
            </div>
          </div>
          <div class="reset-actions">
            <div class="col-12">
              <button type="button" data-bs-toggle="modal" data-bs-target="#deleteReset" class="btn btn-danger reset-delete">DELETE</button>
            </div>
          </div>
        </div>
      </li>
    </template>

    <div class="modal" id="deleteReset">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Delete Reset?</h5>
          </div>
          <div class="modal-body">
            <p>Are you sure you want to delete this reset? You can always create a Reset with identical traits later.</p>
          </div>
          <div class="modal-footer">
            <form id="delete-reset-form" class="needs-validation" novalidate>
                <input type="hidden" id="reset-modal-reset-id" name="resetId" value="">
                <input type="hidden" id="reset-modal-counter-id" name="counterId" value="">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>            
            <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cancel</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal" id="deleteCounter">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Delete Counter?</h5>
          </div>
          <div class="modal-body">
            <p>Are you sure you want to delete this reset? This action is <strong>permanent.</strong> Are you sure you want to proceed with this?</p>
          </div>
          <div class="modal-footer">
            <form id="delete-counter-form" class="needs-validation" novalidate>
                <input type="hidden" id="counter-modal-counter-id" name="counterId" value="">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>            
            <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cancel</button>
          </div>
        </div>
      </div>
    </div>

    <div class="container main p-3">
      <h2 class="text-center text-break display-4">Days Since {{.CounterTitle}}</h2>
      <h6 class="text-center text-break"><i>{{.CounterDescription}}</i></h6>
      <h1 class="text-center days-since display-1 fw-bold" data-timestamp="{{ .MostRecentTimestamp }}"> </h1>

      <form action="/reset/{{.CounterID}}" method="GET" class="w-50 mx-auto">
        <input type="submit" class="btn btn-primary my-2 mx-auto" value="Reset">
     
        {{if or .EBoard .RTP (eq .UserID .CounterOwnerUUID)}}
          <button type="button" data-bs-toggle="modal" data-counter-id="{{ $.CounterID}}" data-bs-target="#deleteCounter" class="btn btn-danger ms-4">DELETE</button>
        {{end}} 
      </form>
      <br/>
      <div>
          <ul id="reset-list" class="list-group list-unstyled text-wrap text-break w-75 mx-auto">
          </ul>
      </div>
    </div>
  <div id="scroll-sentinel" style="height:1px"></div> {{/* hi storemcloud! */}}
  <script>
    (() => {
		'use strict'

    function daysSince(ts) {
      return Math.floor((Date.now() - ts * 1000) / 86400000);
    }

    function renderTimestamp(ts) {
      const date = new Date(ts * 1000);
      const weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
      const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

      return `${weekdays[date.getDay()]}, ${months[date.getMonth()]} ${date.getDate()}, ${date.getFullYear()} at ${date.getHours() % 12 == 0 ? "12" : date.getHours() % 12}:${date.getMinutes().toString().padStart(2, "0")} ${date.getHours() < 12 ? "AM" : "PM"}`;
    }

    document.getElementById("deleteReset").addEventListener("show.bs.modal", function(event) {
        let button = event.relatedTarget
        document.getElementById("reset-modal-reset-id").value = button.getAttribute("data-reset-id")
        document.getElementById("reset-modal-counter-id").value = button.getAttribute("data-counter-id")
    })

    document.getElementById("deleteCounter").addEventListener("show.bs.modal", function(event) {
        let button = event.relatedTarget
        document.getElementById("counter-modal-counter-id").value = button.getAttribute("data-counter-id")
    })
    
    const delete_reset_form = document.getElementById("delete-reset-form")
    delete_reset_form.addEventListener('submit', async event => {
      event.preventDefault(); 
      const button = delete_reset_form.querySelector('[type="submit"]');
      button.disabled = true;

      const data = Object.fromEntries(new FormData(delete_reset_form));

      try {
        const response = await fetch('/api/v1/reset', {
          method: 'DELETE',
          headers: {'Content-Type': 'application/json'},
          credentials: 'include',
          body: JSON.stringify({
            "reset_id": document.getElementById("reset-modal-reset-id").value,
          }),
        });

        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const result = await response.json();

        if (result) {
          window.location.replace("/counter/" + {{ $.CounterID }});
        } else {
          window.location.replace("/");        
        }

      } catch (err) {
        console.error('Error:', err);
        button.disabled = false;
      }
    });

    const delete_counter_form = document.getElementById("delete-counter-form")
    delete_counter_form.addEventListener('submit', async event => {
      event.preventDefault(); 
      const button = delete_counter_form.querySelector('[type="submit"]');
      button.disabled = true;

      const data = Object.fromEntries(new FormData(delete_counter_form));

      try {
        const response = await fetch('/api/v1/counter', {
          method: 'DELETE',
          headers: {'Content-Type': 'application/json'},
          credentials: 'include',
          body: JSON.stringify({
            "counter_id": document.getElementById("counter-modal-counter-id").value
          }),
        });

        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        
        window.location.replace("/");

      } catch (err) {
        console.error('Error:', err);
        button.disabled = false;
      }
    });

    function renderReset(r) {
      const li = template.content.firstElementChild.cloneNode(true);
      li.querySelector(".reset-desc").textContent = r.description;
      li.querySelector(".reset-user").textContent = r.username;
      li.querySelector(".reset-timestamp").textContent = renderTimestamp(r.timestamp);
      li.querySelector(".days-since").textContent = daysSince(r.timestamp);

      if (r.can_delete) {
        const btn = li.querySelector(".reset-delete");
        btn.dataset.resetId = r.id;
        btn.dataset.counterId = counterId;
      } else {
        const div = li.querySelector(".border-bottom");
        div.classList.remove("border-bottom");
        div.classList.remove("mb-2");

        li.querySelector(".reset-actions").remove();
      }
      return li;
    }

    const counterId = {{ .CounterID }};
    const template = document.getElementById("reset-card-template");
    const list = document.getElementById("reset-list");
    let loading = false;
    let done = false;
    let timestamp = null

    async function loadMore() {
      if (loading || done) return;
      loading = true;

      try {
        const res = await fetch("/api/v1/reset", {
          method: "QUERY",
          credentials: "include",
          headers: { "Content-Type": "application/json"},
          body: JSON.stringify({ "counter_id": {{.CounterID}}, "filter": {"timestamp": timestamp, "sort_descending": true} }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();

        const frag = document.createDocumentFragment();
        data.resets.forEach(r => frag.appendChild(renderReset(r)));
        list.appendChild(frag);

        const last = data.resets.at(-1);
        if (data.timestamp) timestamp = data.timestamp;

        if (data.resets.length === 0 || !data.has_more) {
          done = true;
          observer.disconnect();
        }
      } catch (err) {
        console.error("Error loading more:", err);
      } finally {
        loading = false;
      }
    }

	function clearResets() {
		list.replaceChildren();   
		timestamp = null;         
		done = false;
		loading = false;
		observer.observe(document.getElementById("scroll-sentinel")); 
		loadMore();
	}

    document.querySelectorAll("h1.days-since").forEach(el => {
      el.textContent = daysSince(el.dataset.timestamp);
    });

    const observer = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) loadMore();
    }, { rootMargin: "300px" }); 
    observer.observe(document.getElementById("scroll-sentinel"));
	
    })();
  </script>
  </body>
</html>
{{ end }}
